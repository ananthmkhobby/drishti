# ─────────────────────────────────────────────────────────────────────────────
# ACI Frontend – environment configuration
# Copy to .env.local and edit before running.
#
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────────────────────

# Base URL for the FastAPI backend.
# Default points to the local dev server on port 8000.
# Change to your staging/production URL for deployments.
NEXT_PUBLIC_API_URL=http://localhost:8000/v1
