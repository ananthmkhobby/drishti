# ─────────────────────────────────────────────────────────────────────────────
# ACI Backend – environment configuration
# Copy to .env and edit before running.
#
# QUICK-START (SQLite, no external services):
#   cp .env.example .env
#   # Uncomment the SQLite DATABASE_URL below and comment out the PostgreSQL one
#
# PRODUCTION-LIKE (PostgreSQL + Redis via Docker):
#   docker compose up -d postgres redis      # from repo root
#   # Keep the PostgreSQL DATABASE_URL as-is
#
# CLOUD DEPLOYMENTS:
#   Vercel frontend + Fly.io/Railway backend: see backend/fly.toml or backend/railway.toml
#   Supabase DB: paste the postgres:// connection string — the driver prefix is auto-corrected
#   AWS RDS:     same — paste postgresql:// as-is
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME="ACI Backend"
ENVIRONMENT=development          # development | staging | production
DEBUG=true
API_PREFIX=/v1

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. In development, "*" is used automatically.
# In production set this to your Vercel app URL(s).
# Example: ALLOWED_ORIGINS=https://aci-app.vercel.app,https://www.yourschool.com
ALLOWED_ORIGINS=

# ── Database ─────────────────────────────────────────────────────────────────
# Option A – PostgreSQL (production-like; requires running postgres)
DATABASE_URL=postgresql+asyncpg://aci:aci@localhost:5432/aci

# Option B – SQLite (zero setup, dev/test only; uncomment to use)
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Option C – Supabase / Railway / Render / Neon (paste as-is, prefix auto-corrected)
# DATABASE_URL=postgres://user:pass@db.supabase.co:5432/postgres

# ── Redis (only needed if running Celery workers) ─────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
# Change this to a long random string before any staging/production deployment.
JWT_SECRET_KEY=change-me-before-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440          # 24 hours

# ── Auth ──────────────────────────────────────────────────────────────────────
# SKIP_AUTH=true bypasses all JWT validation — every request is accepted as
# DEV_TEACHER_ID.  Safe for local dev; NEVER enable in staging or production.
SKIP_AUTH=true
DEV_TEACHER_ID=00000000-0000-0000-0000-000000000001

# ── Storage ───────────────────────────────────────────────────────────────────
# USE_S3=false  → all files stored under UPLOAD_DIR on local disk.
# USE_S3=true   → frames, audio, video, and lesson plans stored in S3.
#                 Works with AWS S3, Supabase Storage (S3-compatible), and Cloudflare R2.
#                 In production always set USE_S3=true — containers lose local files on restart.
USE_S3=false
UPLOAD_DIR=./uploads             # created automatically on startup; bind-mount a volume if USE_S3=false
MAX_FRAME_SIZE_MB=10
MAX_FRAMES_PER_SESSION=200

# ── AWS S3 (production only — ignored when USE_S3=false) ─────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=aci-uploads

# ── Celery ────────────────────────────────────────────────────────────────────
# false → Celery tasks are dispatched to Redis (requires worker process).
# true  → Tasks run synchronously inline (useful for debugging; do not use in prod).
CELERY_ALWAYS_EAGER=false

# ── OpenAI (AI generation) ────────────────────────────────────────────────────
# Leave blank to use placeholder AI outputs (synthetic but structurally correct).
# Fill in to use real GPT-4o generation.
OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=gpt-4o
OPENAI_MODEL_MINI=gpt-4o-mini
AI_MAX_RETRIES=3
AI_REQUEST_TIMEOUT_SEC=60
AI_MAX_OCR_TOKENS=4000

# ── Voice assistant (local Qwen via Ollama, OpenAI as fallback) ──────────────
# true  → try local Qwen first for intent classification + Brain Q&A (fast on
#         a Mac/PC with real CPU/GPU; ~1-2s).
# false → skip straight to OpenAI. Set false on hardware too slow to prefill
#         the ~2.7k-token system prompt within VOICE_INTENT_TIMEOUT_SEC (e.g.
#         a Raspberry Pi's CPU-only inference) — measure with a direct
#         `time curl localhost:11434/api/generate` call before assuming.
LOCAL_LLM_ENABLED=true

# Local Whisper (whisper.cpp's whisper-server, run via deploy/whisper-setup.sh)
# for VOICE COMMAND transcription only — not the long-form lecture-recording
# pipeline (POST /sessions/{id}/audio), which stays on OpenAI for its richer
# confidence-score hallucination filtering. Measured ~40-100ms per short
# command on a warm server (vs several seconds round-tripping to OpenAI from
# a Pi). Falls back to OpenAI automatically if the local server is down.
LOCAL_WHISPER_ENABLED=true
LOCAL_WHISPER_URL=http://localhost:8080

# ── Wake word ("Hey XP", via openWakeWord) ────────────────────────────────────
# Only set true on the machine with the actual microphone attached (normally
# the Pi, not a dev laptop) and after `pip install -e ".[wake-word]"` there.
# The trained model ships committed at WAKE_WORD_MODEL_PATH — if that file is
# ever missing, detection falls back to a pretrained stock keyword instead
# (say "Hey Jarvis" to test the pipeline in that case; see
# app/services/wake_word_service.py).
WAKE_WORD_ENABLED=false
WAKE_WORD_MODEL_PATH=./models/hey_xp.onnx
WAKE_WORD_THRESHOLD=0.5
